  {
    "index": 44,
    "pointer_offset": "0x0058",
    "file_offset": "0x08c0",
    "jp": "あたし、つまんなくても、物って大好き。{n}おじちゃん、ありがとね。",
    "tr": "Even boring gifts are still gifts! Thanks, mister.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 45,
    "pointer_offset": "0x005a",
    "file_offset": "0x0902",
    "jp": "まあ、嬉しい。{n}次はもっと、いいものくれるんでしょう？",
    "tr": "Oh, how lovely. You'll bring me something even nicer next time, won't you?",
    "reviewed": false,
