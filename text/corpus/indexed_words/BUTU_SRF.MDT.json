[
  {
    "index": 0,
    "pointer_offset": "0x0000",
    "file_offset": "0x0400",
    "jp": "要ラヌワ・・・{n}シマッテオケ。",
    "tr": "I HAVE NO NEED OF IT... PUT IT AWAY.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 1,
    "pointer_offset": "0x0002",
    "file_offset": "0x0420",
    "jp": "ソレ、イラナイ。{n}オレニハ、イラナイ。",
    "tr": "THAT, NO NEED. I DO NOT NEED IT.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 2,
    "pointer_offset": "0x0004",
    "file_offset": "0x0448",
    "jp": "我には要り用のない物。{n}もとに収めておくがよろし。",
    "tr": "I have no need of such a thing. You would do well to put it away.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 3,
    "pointer_offset": "0x0006",
    "file_offset": "0x047c",
    "jp": "ふむ、文字通りつまらないものですね。{n}私は遠慮させていただきましょう。",
    "tr": "Hmm. A trifle in every sense of the word. I shall decline.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 4,
    "pointer_offset": "0x0008",
    "file_offset": "0x04c4",
    "jp": "わたくしに、まさかそのような不粋な物が{n}似合うと、お思いではないでしょうね。",
    "tr": "Surely you do not imagine such a tasteless thing would suit me.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 5,
    "pointer_offset": "0x000a",
    "file_offset": "0x0512",
    "jp": "なんだよそれ、要らねえよそんなもん。",
    "tr": "What the hell is that? I don't need it.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 6,
    "pointer_offset": "0x000c",
    "file_offset": "0x0538",
    "jp": "なにそれー、あんたバカじゃないの？",
    "tr": "What's that supposed to be? Are you stupid?",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 7,
    "pointer_offset": "0x000e",
    "file_offset": "0x055c",
    "jp": "子供を物でつるつもりなの？{n}まったく大人ってのは・・・。",
    "tr": "You think you can bribe a kid with stuff? Adults, I swear...",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 8,
    "pointer_offset": "0x0010",
    "file_offset": "0x0596",
    "jp": "おじちゃん、あたし、そんなの要らない。",
    "tr": "Uncle, I don't need that.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 9,
    "pointer_offset": "0x0012",
    "file_offset": "0x05be",
    "jp": "まあ、嬉しい。{n}でも、気持ちだけ頂くことにするわね。",
    "tr": "Oh, how sweet. But it's the thought that counts.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 10,
    "pointer_offset": "0x0014",
    "file_offset": "0x05f4",
    "jp": "えへへへへ、いいもんくれんじゃねえか。{n}さっそく捨ててやるよ。",
    "tr": "Heh heh heh! What a lovely gift. I'll throw it away at once.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 11,
    "pointer_offset": "0x0016",
    "file_offset": "0x0634",
    "jp": "ふぉっふぉっふぉっ、{n}そいつは、わしには不用のものじゃのう。",
    "tr": "Ho ho ho! I have no use for that.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 12,
    "pointer_offset": "0x0018",
    "file_offset": "0x0672",
    "jp": "キミ、ゴミはくずかごに捨てたまえ。{n}そんなもの渡されても困るんだよ。",
    "tr": "Trash belongs in the bin. Don't burden me with it.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 13,
    "pointer_offset": "0x001a",
    "file_offset": "0x06b8",
    "jp": "そんなしょーもないもん、いるか！{n}もっとましなもん、持ってこい。",
    "tr": "Who wants that worthless junk?! Bring me something decent.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 14,
    "pointer_offset": "0x001c",
    "file_offset": "0x06fa",
