  },
  {
    "index": 75,
    "pointer_offset": "0x0096",
    "file_offset": "0x0b12",
    "jp": "貴殿に忠誠を誓う時も、{n}そう遠くはないだろう。",
    "tr": "The day I swear my loyalty to you may not be far off.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 76,
    "pointer_offset": "0x0098",
    "file_offset": "0x0b42",
    "jp": "そんなに私のことが気になりますの？{n}今夜、つきあってあげてもよくってよ。",
    "tr": "Am I really on your mind that much? Perhaps I'll keep you company tonight.",
    "reviewed": false,
    "excluded": false
  },
  {
    "index": 77,
    "pointer_offset": "0x009a",
