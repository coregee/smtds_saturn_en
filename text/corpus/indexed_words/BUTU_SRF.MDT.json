  },
  {
    "index": 74,
    "pointer_offset": "0x0094",
    "file_offset": "0x0ae8",
    "jp": "我らのきずな、{n}より堅固に結ばれていく。",
    "tr": "The bond between us grows ever stronger.",
    "reviewed": false,
